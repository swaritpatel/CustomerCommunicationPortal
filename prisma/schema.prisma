generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  ADMIN
  AGENT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ConversationStatus {
  OPEN
  SNOOZED
  RESOLVED
}

enum ConversationChannel {
  EMAIL
  CHAT_WIDGET
}

enum ChatSenderType {
  VISITOR
  AGENT
  SYSTEM
}

enum TypingActorType {
  VISITOR
  AGENT
}

enum EmailMessageSource {
  INBOUND
  OUTBOUND
}

enum AssignmentAction {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

enum AuditAction {
  USER_SIGNED_UP
  USER_LOGGED_IN
  USER_LOGGED_OUT
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  WORKSPACE_CREATED
  MEMBER_INVITED
  INVITE_REVOKED
  INVITE_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  CONVERSATION_ASSIGNED
  CONVERSATION_UNASSIGNED
}

enum KnowledgeBaseArticleStatus {
  DRAFT
  PUBLISHED
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum CustomDomainSslStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
}

model User {
  id                    String                 @id @default(cuid())
  fullName              String
  email                 String                 @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           WorkspaceMember[]
  ownedWorkspaces       Workspace[]            @relation("WorkspaceOwner")
  invitesAccepted       Invite[]               @relation("InviteAcceptedBy")
  issuedSessions        Session[]
  passwordResetTokens   PasswordResetToken[]
  authoredAuditLogs     AuditLog[]             @relation("AuditActor")
  assignedConversations Conversation[]         @relation("ConversationAssignee")
  assignmentEventsFrom  AssignmentEvent[]      @relation("AssignmentFromUser")
  assignmentEventsTo    AssignmentEvent[]      @relation("AssignmentToUser")
  chatMessages          ChatMessage[]
  typingStates          ChatTypingState[]
  conversationComments  ConversationComment[]
  cannedResponses       CannedResponse[]
  supportPolicies       SupportPolicy[]
  knowledgeBaseArticles KnowledgeBaseArticle[]
}

model Workspace {
  id                      String                  @id @default(cuid())
  name                    String
  slug                    String                  @unique
  ownerId                 String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  owner                   User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members                 WorkspaceMember[]
  invites                 Invite[]
  auditLogs               AuditLog[]
  conversations           Conversation[]
  assignmentEvents        AssignmentEvent[]
  chatMessages            ChatMessage[]
  conversationComments    ConversationComment[]
  typingStates            ChatTypingState[]
  emailReferences         EmailMessageReference[]
  gmailIntegrations       GmailIntegration[]
  cannedResponses         CannedResponse[]
  supportPolicies         SupportPolicy[]
  knowledgeBaseCategories KnowledgeBaseCategory[]
  knowledgeBaseArticles   KnowledgeBaseArticle[]
  knowledgeBaseDomains    KnowledgeBaseDomain[]
}

model GmailIntegration {
  id           String    @id @default(cuid())
  workspaceId  String
  email        String
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  historyId    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, updatedAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  status      MemberStatus  @default(ACTIVE)
  lastSeenAt  DateTime?
  invitedAt   DateTime?
  joinedAt    DateTime?
  removedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model Invite {
  id           String        @id @default(cuid())
  workspaceId  String
  email        String
  role         WorkspaceRole
  token        String        @unique
  status       InviteStatus  @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  acceptedBy   User?         @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([workspaceId, email])
  @@index([workspaceId, status])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Conversation {
  id                String                  @id @default(cuid())
  workspaceId       String
  ticketNumber      String?
  subject           String
  channel           ConversationChannel     @default(CHAT_WIDGET)
  customerKey       String?
  customerName      String?
  customerEmail     String?
  visitorLastSeenAt DateTime?
  status            ConversationStatus      @default(OPEN)
  currentAssigneeId String?
  ownershipVersion  Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentAssignee   User?                   @relation("ConversationAssignee", fields: [currentAssigneeId], references: [id])
  assignmentEvents  AssignmentEvent[]
  messages          ChatMessage[]
  comments          ConversationComment[]
  typingStates      ChatTypingState[]
  emailReferences   EmailMessageReference[]

  @@unique([workspaceId, ticketNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, currentAssigneeId])
  @@index([workspaceId, channel, updatedAt])
  @@index([workspaceId, customerKey])
}

model EmailMessageReference {
  id             String             @id @default(cuid())
  workspaceId    String
  conversationId String
  messageId      String
  inReplyTo      String?
  source         EmailMessageSource
  createdAt      DateTime           @default(now())
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, messageId])
  @@index([conversationId, createdAt])
  @@index([workspaceId, inReplyTo])
}

model ChatMessage {
  id              String         @id @default(cuid())
  workspaceId     String
  conversationId  String
  senderType      ChatSenderType
  senderUserId    String?
  body            String
  readByVisitorAt DateTime?
  readByAgentAt   DateTime?
  createdAt       DateTime       @default(now())
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?          @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

model ConversationComment {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

model CannedResponse {
  id          String    @id @default(cuid())
  workspaceId String
  tag         String
  body        String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, tag])
  @@index([workspaceId, updatedAt])
}

model ChatTypingState {
  id             String          @id @default(cuid())
  workspaceId    String
  conversationId String
  actorType      TypingActorType
  actorUserId    String?
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorUser      User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, actorType, actorUserId])
  @@index([conversationId, updatedAt])
}

model AssignmentEvent {
  id             String           @id @default(cuid())
  workspaceId    String
  conversationId String
  action         AssignmentAction
  fromUserId     String?
  toUserId       String?
  actorUserId    String
  reason         String?
  createdAt      DateTime         @default(now())
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUser       User?            @relation("AssignmentFromUser", fields: [fromUserId], references: [id])
  toUser         User?            @relation("AssignmentToUser", fields: [toUserId], references: [id])

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime    @default(now())
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?       @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
}

model SupportPolicy {
  id                 String    @id @default(cuid())
  workspaceId        String
  title              String
  category           String
  keywords           String[]  @default([])
  publicGuidance     String
  internalNotes      String?
  autoResolveEnabled Boolean   @default(false)
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, isActive, updatedAt])
  @@index([workspaceId, category])
}

model KnowledgeBaseCategory {
  id          String                 @id @default(cuid())
  workspaceId String
  title       String
  slug        String
  description String?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles    KnowledgeBaseArticle[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, sortOrder])
}

model KnowledgeBaseArticle {
  id           String                     @id @default(cuid())
  workspaceId  String
  categoryId   String?
  authorUserId String?
  title        String
  slug         String
  excerpt      String?
  contentHtml  String
  status       KnowledgeBaseArticleStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     KnowledgeBaseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?                      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, categoryId])
}

model KnowledgeBaseDomain {
  id                String                @id @default(cuid())
  workspaceId       String
  hostname          String                @unique
  status            CustomDomainStatus    @default(PENDING)
  sslStatus         CustomDomainSslStatus @default(PENDING)
  verificationToken String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  failureReason     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([hostname, status])
}
